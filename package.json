{
  "name": "whatsapp-electron",
  "productName": "WhatsApp",
  "version": "1.2.0-rc.1",
  "description": "Unofficial WhatsApp Web desktop wrapper for Linux",
  "author": {
    "name": "UdayaSri0",
    "url": "https://github.com/UdayaSri0"
  },
  "private": true,
  "main": "src/main.js",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/UdayaSri0/whatsapp-electron-main#readme",
  "bugs": {
    "url": "https://github.com/UdayaSri0/whatsapp-electron-main/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UdayaSri0/whatsapp-electron-main.git"
  },
  "engines": {
    "node": ">=22.12 <23 || >=24 <25"
  },
  "scripts": {
    "check:node": "node scripts/check-node.js",
    "prestart": "npm run check:node",
    "start": "electron .",
    "test": "node --test",
    "prebuild": "npm run check:node",
    "build": "electron-builder --linux AppImage --publish never",
    "prebuild:deb": "npm run check:node",
    "build:deb": "electron-builder --linux deb --x64 --publish never",
    "prebuild:rpm": "npm run check:node",
    "build:rpm": "electron-builder --linux rpm --x64 --publish never",
    "prebuild:linux": "npm run check:node",
    "build:linux": "electron-builder --linux AppImage deb rpm --x64 --publish never",
    "prebuild:dir": "npm run check:node",
    "build:dir": "electron-builder --linux dir --publish never",
    "check": "npm run check:node && node scripts/check.js",
    "release:assets": "node scripts/release-assets.js"
  },
  "devDependencies": {
    "electron": "43.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.dluebben.whatsapp-desktop",
    "productName": "WhatsApp",
    "asar": true,
    "compression": "maximum",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "electronLanguages": [
      "de",
      "en-US"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "README.md",
      "NOTICE"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network;InstantMessaging;",
      "icon": "build/icon.png",
      "maintainer": "UdayaSri0",
      "vendor": "UdayaSri0",
      "synopsis": "WhatsApp Web Desktop",
      "description": "Unofficial WhatsApp Web desktop wrapper with tray integration and native notifications.",
      "executableName": "whatsapp",
      "desktop": {
        "entry": {
          "Name": "WhatsApp (unofficial)",
          "Comment": "Unofficial WhatsApp Web desktop wrapper",
          "StartupWMClass": "WhatsApp"
        }
      }
    },
    "appImage": {
      "artifactName": "WhatsApp-${version}-x86_64.AppImage"
    },
    "deb": {
      "artifactName": "whatsapp-electron-${version}-amd64.deb",
      "packageCategory": "net",
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "recommends": [
        "libayatana-appindicator3-1 | libappindicator3-1"
      ]
    },
    "rpm": {
      "artifactName": "whatsapp-electron-${version}-x86_64.rpm",
      "packageCategory": "Applications/Internet"
    }
  },
  "contributors": [
    {
      "name": "Dominik Lübben",
      "url": "https://github.com/DomiLuebben/whatsapp-electron"
    }
  ]
}
